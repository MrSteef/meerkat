# Optional local configuration. Copy to .env (ignored by Git).
# Real environment variables take precedence over these values.
# Do not commit actual credentials.
ORACLE_CONNECTION_STRING=hostname:1521/service
ORACLE_USERNAME=meerkat_reader
ORACLE_PASSWORD=replace-me
MEERKAT_SQLITE_PATH=./meerkat.sqlite
MEERKAT_BIND=127.0.0.1:3000
MEERKAT_TIMEZONE=Europe/Amsterdam
ORACLE_CALL_TIMEOUT_SECONDS=45
ORACLE_MAX_ROWS=2000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_INITIAL_SECONDS=30
WEBHOOK_RETRY_MAX_DELAY_SECONDS=1800
WEBHOOK_TIMEOUT_SECONDS=15
RUST_LOG=info
